    <item>
      <title>iTerm2</title>
      <link>//localhost:1313/docs/mac/iterm2/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>//localhost:1313/docs/mac/iterm2/</guid>
      <description>
        
        
        &lt;h2&gt;Tabs and Windows&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;tabs-and-windows&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#tabs-and-windows&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th&gt;Shortcut&lt;/th&gt;
          &lt;th&gt;Description&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [T]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;New Tab&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [⟶ Right]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Next Tab&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [⟵ Left]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Previous Tab&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [W]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Close Window or Tab&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⇧ Shift] + [⌘ Command] + [⟶ Right]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Move Tab right&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⇧ Shift] + [⌘ Command] + [⟵ Left]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Move Tab left&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [1], [2], &amp;hellip;&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Go to Tab 1,2,&amp;hellip;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [D]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Split Window Vertically&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⇧ Shift] + [⌘ Command] + [D]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Split Window Horizontally&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⌘ Command] + [↵ Enter]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Toggle Fullscreen&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[⇧ Shift] + [⌘ Command] + [↵ Enter]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Maximize&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;h2&gt;Cursor and selection&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;cursor-and-selection&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#cursor-and-selection&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th&gt;Shortcut&lt;/th&gt;
          &lt;th&gt;Description&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[˄ Control] + [B]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Move back one character&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[˄ Control] + [F]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Move forward one character&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[˄ Control] + [D]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Delete current character&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[˄ Control] + [W]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Delete previous word (in shell)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[˄ Control] + [A]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Move to the start of line&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;strong&gt;[˄ Control] + [E]&lt;/strong&gt;&lt;/td&gt;
          &lt;td&gt;Move to the end of line&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;

      </description>
    </item>
    
